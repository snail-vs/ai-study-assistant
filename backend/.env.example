# Provider: openai or any OpenAI-compatible endpoint
# auto uses OpenAI when OPENAI_API_KEY exists; mock forces local demo mode
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Required to persist Provider API keys securely. Generate with:
# python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
STUDYCENTER_ENCRYPTION_KEY=

# Public-web authentication
STUDYCENTER_SESSION_DAYS=30
STUDYCENTER_COOKIE_SECURE=false

# Optional database override
# DATABASE_URL=sqlite:////absolute/path/to/studycenter.db
