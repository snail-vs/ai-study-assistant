{
  "name": "studycenter-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api:generate": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated/schema.ts",
    "api:check": "sh scripts/check-api-generated.sh",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build"
  },
  "dependencies": {
    "@vueuse/core": "^12.0.0",
    "markdown-it": "^14.1.0",
    "openapi-fetch": "^0.13.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0"
  }
}
